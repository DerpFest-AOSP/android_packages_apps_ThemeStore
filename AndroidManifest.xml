<?xml version="1.0" encoding="utf-8"?>
<manifest 
    xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.android.axion.axthemestore"
    android:sharedUserId="android.uid.system">

    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.DayNight"
        android:supportsRtl="true">
        
        <!--
             Section-specific UI: intent extra
             com.android.axion.axthemestore.extra.STORE_SECTION (string):
             network_icons — Wi‑Fi / signal / data catalog only;
             battery_style — battery shape overlays only;
             back_gesture — back gesture overlays only;
             charging_animation — charging animation overlays only;
             status_bar_customization — all three customization types in one screen (legacy);
             all or omit — full store (default).
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:windowSoftInputMode="adjustResize">
        </activity>

    </application>

</manifest>
